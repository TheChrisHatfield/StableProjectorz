# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Bb]uild_IL2CPP/
/[Ll]ogs/
build_*.txt
/[Uu]ser[Ss]ettings/
/stable-fast-3d*
/Shadow_R*
/trellis-stable-projectorz*
/rembg-stable-projectorz*

/gen3d/*

# Ignore .glb and .mp4 files only in the root directory
/*.glb
/*.mp4
/*.obj
/*.fbx

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Cursor IDE — local/editor state and skills (not for remote)
.cursor/

# --- Local / agent / not required for end-user Unity compile-build ---
# Agent & Hive
.hive/
AGENTS.md
START_HERE.md
/continual-learning/
/cartridge/
/context-library/
.github/

# Dev tooling & Python soil (not the Unity app)
/tools/
/src/
/tests/
/pyproject.toml
/spec-kit-agent-integration.md

# Agent planning docs (specs, proposals, delta) — not needed to open/build in Unity
/docs/

# Local SD / webui clone (huge; install separately)
/stable-diffusion-webui-forge/

# Root junk / local push helpers / machine-specific
/*.lnk
/AbrDump.cs
/AUDIT_*.md
/push_to_github.bat
/update_github.bat
/spz.config
/BUILD_SYSTEM_ANALYSIS.md
/UNITY_HUB_LOCATIONS.md
/compile_check.txt
/module_install_log.txt
/push_diagnostic.txt

# Visual Studio cache directory
.vs/

# Gradle cache directory 
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

*.exe

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

TestDownloadsIntoHere/

# Ignore everything in the InnoSetup directory
/InnoSetup/*

# But don't ignore the directories inside InnoSetup
!/InnoSetup/*/
*.zip

# --- Local only (keep for working, do not upload to GitHub) ---
.DS_Store
Thumbs.db
*.stackdump
*.log
.env
.env.local
*.local
*.bak
*~
/[Ll]ocal/
/[Pp]layer_[Ll]ogs/

# Python bytecode (addon scripts under StreamingAssets)
**/__pycache__/
*.pyc